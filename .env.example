# VyaparSetu - Environment Configuration
# THIS IS A DEMO APPLICATION - DO NOT USE IN PRODUCTION

# Database
DATABASE_URL=postgresql://demo_user:demo_password@postgres:5432/vyaparsetu

# Authentication (demo only)
JWT_SECRET=demo-only-replace-me
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Application
APP_ENV=demo
CORS_ORIGINS=http://localhost:5173

# Intentional vulnerability feature flags (for CyberQuant demo)
DEMO_VULN_BOLA=true
DEMO_VULN_SQLI=true
DEMO_VULN_XSS=true
DEMO_VULN_ADMIN_AUTH=true
DEMO_VULN_DATA_EXPOSURE=true
DEMO_VULN_HEADERS=true

# Dummy secret for Gitleaks demo
DEMO_API_KEY=THIS_IS_NOT_A_REAL_SECRET_DO_NOT_USE
DEMO_PAYMENT_GATEWAY_KEY=test_pk_not_a_real_key_12345
